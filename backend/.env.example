# Скопіювати як .env і за потреби змінити значення.

# PostgreSQL (підіймається через docker compose)
POSTGRES_USER=finance_user
POSTGRES_PASSWORD=finance_pass
POSTGRES_DB=finance_db
POSTGRES_HOST=localhost
# 5433, а не 5432, щоб не конфліктувати з локально встановленим PostgreSQL
POSTGRES_PORT=5433

DATABASE_URL=postgresql+asyncpg://finance_user:finance_pass@localhost:5433/finance_db

# Часовий пояс, за яким статистика групує транзакції по добах
APP_TIMEZONE=Europe/Kyiv

# Ключ підпису JWT. Лишіть порожнім — застосунок згенерує випадковий при
# першому запуску й сам допише його сюди. Дефолтного значення навмисно немає:
# зі спільним відомим ключем можна підробити токен на чужий акаунт.
JWT_SECRET=
# Скільки годин живе токен (за замовчуванням 30 днів)
JWT_TTL_HOURS=720

# AI-асистент. Підходить будь-який OpenAI-сумісний провайдер.
#
# Groq (хмара): ключ з console.groq.com/keys. Питання й знайдені записи
# (суми, категорії, нотатки) ідуть на сервер Groq.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
#
# Ollama (локально, дані не виходять з комп'ютера): ключ не потрібен.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b
#
# Стара назва ключа GROQ_API_KEY теж працює. Без ключа й без локальної
# моделі асистент вимкнений, решта застосунку працює.
